$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback] from "@iosevka/util"

glyph-module

glyph-block Symbol-Math-Complement : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Letter-Latin-C : CLetterForm

	define SLAB-NONE 0

	create-glyph 'complement' 0x2201 : glyph-proc
		local top : mix SymbolMid OperTop 1.1
		local bot : mix SymbolMid OperBot 1.1
		local lf : CLetterForm [DivFrame 1] SLAB-NONE SLAB-NONE top bot
			sw -- OperatorStroke
		include : lf.full
