$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback] from "@iosevka/util"
import [MathSansSerif] from "@iosevka/glyph/relation"

glyph-module

glyph-block Letter-Latin-Upper-E : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Letter-Shared : CreateAccentedComposition SetGrekUpperTonos CreateTurnedLetter
	glyph-block-import Letter-Shared-Metrics : EFMidBarShrinkK EFMidBarPosY EFVJutLength
	glyph-block-import Letter-Shared-Shapes : LetterBarOverlay

	define kSB 1.0
	define xEBarLeft     : [mix 0     SB      kSB] - O
	define xRevEBarRight : [mix Width RightSB kSB] + O

	define [EShape top serifLT serifLB serifRT serifRB serifRM _stroke _jutTop _jutBot] : glyph-proc
		local stroke : fallback _stroke Stroke
		local xMidBarRight : mix Width RightSB : EFMidBarShrinkK [DivFrame 1] serifRT
		local barPos : EFMidBarPosY top 0

		include : tagged 'strokeL' : VBar.l xEBarLeft 0 top stroke
		include : tagged 'strokeT' : HBar.t (xEBarLeft - O) RightSB      top    stroke
		include : tagged 'strokeM' : HBar.m (xEBarLeft - O) xMidBarRight barPos stroke
		include : tagged 'strokeB' : HBar.b (xEBarLeft - O) RightSB      0      stroke

		if serifLT : include : tagged 'serifLT' : HSerif.lt xEBarLeft top SideJut stroke
		if serifLB : include : tagged 'serifLB' : HSerif.lb xEBarLeft 0   SideJut stroke

		local { jutTop jutBot jutMid } : EFVJutLength top 0 nothing stroke _jutTop _jutBot
		local swVJut : VJutStroke * (stroke / Stroke)
		if serifRT : include : tagged 'serifRT' : VSerif.dr RightSB      top    jutTop swVJut
		if serifRB : include : tagged 'serifRB' : VSerif.ur RightSB      0      jutBot swVJut
		if serifRM : include : tagged 'serifRM' : VSerif.mr xMidBarRight barPos jutMid swVJut

	define [RevEShape top serifRT serifRB serifLT serifLB serifLM _stroke _jutTop _jutBot] : glyph-proc
		local stroke : fallback _stroke Stroke
		local xMidBarLeft : mix 0 SB : EFMidBarShrinkK [DivFrame 1] serifLT
		local barPos : EFMidBarPosY top 0

		include : tagged 'strokeR' : VBar.r xRevEBarRight 0 top stroke
		include : tagged 'strokeT' : HBar.t SB          (xRevEBarRight + O) top    stroke
		include : tagged 'strokeM' : HBar.m xMidBarLeft (xRevEBarRight + O) barPos stroke
		include : tagged 'strokeB' : HBar.b SB          (xRevEBarRight + O) 0      stroke

		if serifRT : include : tagged 'serifRT' : HSerif.rt xRevEBarRight top SideJut stroke
		if serifRB : include : tagged 'serifRB' : HSerif.rb xRevEBarRight 0   SideJut stroke

		local { jutTop jutBot jutMid } : EFVJutLength top 0 nothing stroke _jutTop _jutBot
		local swVJut : VJutStroke * (stroke / Stroke)
		if serifLT : include : tagged 'serifLT' : VSerif.dl SB          top    jutTop swVJut
		if serifLB : include : tagged 'serifLB' : VSerif.ul SB          0      jutBot swVJut
		if serifLM : include : tagged 'serifLM' : VSerif.ml xMidBarLeft barPos jutMid swVJut

	define EConfig : object
		serifless      { false false false false false }
		topLeftSerifed { true  false false false false }
		serifed        { true  true  true  true  false }
		serifedCapped  { true  true  true  true  true  }

	foreach { suffix { lt lb rt rb rm } } [Object.entries EConfig] : do
		define swCap : AdviceStroke2 2 3 CAP
		define swXH  : AdviceStroke2 2 3 XH

		create-glyph "E.\(suffix)" : glyph-proc
			include : MarkSet.capital
			include : EShape CAP lt lb rt rb rm swCap
			set-base-anchor 'trailing' RightSB 0

		create-glyph "grek/Epsilon.\(suffix)" : glyph-proc
			include [refer-glyph "E.\(suffix)"] AS_BASE ALSO_METRICS
			include : SetGrekUpperTonos [if lt (-SideJut) 0]

		create-glyph "smcpE.\(suffix)" : glyph-proc
			include : MarkSet.e
			include : EShape XH lt lb rt rb rm swXH
			set-base-anchor 'trailing' RightSB 0

		create-glyph "smcpEBar.\(suffix)" : glyph-proc
			include [refer-glyph "smcpE.\(suffix)"] AS_BASE ALSO_METRICS
			local barPos : EFMidBarPosY XH 0
			local swVJut : VJutStroke * (swXH / Stroke)
			local xRight : piecewise
				rm : [mix Width RightSB : EFMidBarShrinkK [DivFrame 1] rt] - [HSwToV swVJut]
				rb :            RightSB                                    - [HSwToV swVJut]
				true      Width
			include : LetterBarOverlay.l.in
				x     -- xEBarLeft
				top   -- (barPos - swXH / 2)
				bot   -- (0 + swXH)
				space -- { 0 xRight }

		create-glyph "EHookRight.\(suffix)" : glyph-proc
			include : MarkSet.capital
			local hook : Math.min Hook
				RHook * (CAP / XH) + swCap / 2
				mix swCap (CAP - ([EFMidBarPosY CAP 0] + swCap / 2)) 0.554
			include : EShape CAP lt lb rt rb rm swCap hook
			eject-contour 'serifRT'
			eject-contour 'strokeT'
			include : dispiro
				widths.lhs swCap
				g4.up.start (RightSB - OX) (CAP - hook) [heading Upward]
				arcvh nothing DesignParameters.rHookSuperness
				flat [Arch.adjust-x.top [mix RightSB [Math.max xEBarLeft : [mix 0 SB 1.5] + 0.75 * OX] 0.5] (sw -- swCap)] CAP
				curl (xEBarLeft - O) CAP [heading Leftward]

		create-glyph "revE.\(suffix)" : glyph-proc
			include : MarkSet.capital
			include : RevEShape CAP lt lb rt rb rm swCap

	select-variant 'E' 'E'
	link-reduced-variant 'E/sansSerif' 'E' MathSansSerif
	select-variant 'grek/Epsilon' 0x395 (follow -- 'E')
	link-reduced-variant 'grek/Epsilon/sansSerif' 'grek/Epsilon' MathSansSerif (follow -- 'E/sansSerif')

	alias 'cyrl/Ye' 0x415 'E'

	select-variant 'revE'   0x18E  (follow -- 'E')
	select-variant 'exists' 0x2203 (follow -- 'E/sansSerif') (shapeFrom -- 'revE')
	CreateAccentedComposition 'notExists' 0x2204 'exists' 'longSlash'

	select-variant 'smcpE'    0x1D07  (follow -- 'E')
	select-variant 'smcpEBar' 0x1DF43 (follow -- 'E')
	CreateTurnedLetter 'turnSmcpE' 0x2C7B 'smcpE' HalfAdvance (XH / 2)

	select-variant 'EHookRight' 0x1DF81 (follow -- 'E')

	glyph-block-import Letter-Blackboard : BBS BBD
	create-glyph 'mathbb/E' 0x1D53C : glyph-proc
		include : MarkSet.capital
		include : union
			difference
				EShape CAP false false false false false BBS
				Rect (CAP - BBS) BBS (xEBarLeft + [HSwToV BBS]) (xEBarLeft + BBD)
			VBar.l (xEBarLeft + BBD) 0 CAP BBS
