$$include '../../meta/macros.ptl'

import [mix fallback SuffixCfg] from "@iosevka/util"
import [MathSansSerif] from "@iosevka/glyph/relation"
import [maskBits bitOr] from "@iosevka/util/mask-bit"
import [Seg] from "@iosevka/geometry/segment"

glyph-module

glyph-block Letter-Latin-Upper-A : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Mark-Shared-Metrics : markHalfStroke
	glyph-block-import Letter-Shared : CreateAccentedComposition
	glyph-block-import Letter-Shared : SetGrekUpperTonos CreateTurnedLetter
	glyph-block-import Letter-Shared-Metrics : BowlXDepth
	glyph-block-import Letter-Shared-Shapes : SerifFrame
	glyph-block-import Letter-Latin-V : VShapeOutline VShape VCornerHalfWidth
	glyph-block-import Letter-Latin-V : VStraightSbShrink VStraightSbOffset

	define BODY-CURLY      0
	define BODY-STRAIGHT   1
	define BODY-ROUND-TOP  2

	define SLAB-NONE       0
	define SLAB-TOP        1
	define SLAB-LEFT       2
	define SLAB-RIGHT      4
	define SLAB-SMALL-CYRL 8

	glyph-block-export AShape
	define AShape : namespace
		export : define [BarPos bodyShape slabKind top] : begin
			local fBaseSlabs : maskBits slabKind : bitOr SLAB-LEFT SLAB-RIGHT
			return : mix [if fBaseSlabs Stroke 0] top : Math.min 0.5 : match bodyShape
				[Just BODY-ROUND-TOP] : (XH * 0.75) / CAP
				__                    : (XH * 0.50) / CAP

		export : define [Mask df bodyShape top sw] : new-glyph : glyph-proc
			include : match bodyShape
				([Just BODY-CURLY] || [Just BODY-STRAIGHT]) : VShapeOutline df bodyShape top sw
				[Just BODY-ROUND-TOP] : UShapeOutline top 0 df.leftSB df.rightSB sw df.archDepthA df.archDepthB
			include : FlipAround df.middle (top / 2)

		export : define [Outer df bodyShape top sw] : new-glyph : glyph-proc
			include : match bodyShape
				([Just BODY-CURLY] || [Just BODY-STRAIGHT]) : VShape df bodyShape top sw
				[Just BODY-ROUND-TOP] : UShape top 0 df.leftSB df.rightSB sw df.archDepthA df.archDepthB
			include : FlipAround df.middle (top / 2)

		define [CrossBar df bodyShape top sw] : begin
			local yBar : BarPos bodyShape slabKind top
			return : tagged 'crossBar' : intersection [HBar.t 0 df.width yBar sw] [Mask df bodyShape top sw]

		export : define [Letter df bodyShape slabKind top sw] : new-glyph : glyph-proc
			include : Outer df bodyShape top sw
			include : CrossBar df bodyShape top sw
			include : ASerifs df top sw slabKind

		define [CuspBottomRightRemovedImpl df bodyShape slabKind top sw] : new-glyph : glyph-proc
			local yBar : BarPos bodyShape slabKind top
			include : VShape df bodyShape top sw
			eject-contour 'strokeDown'
			include : FlipAround df.middle (top / 2)

			local cornerHW : VCornerHalfWidth * (sw / Stroke)
			define [rightStrokeKnots] : let [s : Seg (df.middle + cornerHW) top df.rightSB (yBar - sw)] : list
				s.z (-1)  flat
				s.z  0    flat
				s.zz 0.55 [StrokeWidthBlend 0.48 0.45] [if bodyShape curl g4]
				s.z (+1)  straight.down.end

			include : intersection [MaskBelow top] [MaskAbove (yBar - sw)] : dispiro
				widths.rhs sw
				rightStrokeKnots

			include : tagged 'crossBar' : intersection [HBar.t 0 df.width yBar sw] : union
				AShape.Mask df bodyShape top sw
				intersection [MaskRight df.middle] [MaskAbove (yBar - sw)] : spiro-outline
					rightStrokeKnots
					corner df.rightSB 0
					corner 0          0
					corner 0          top

			include : ASerifs df top sw slabKind
			eject-contour 'serifRB'

		define [RoundTopBottomRightRemovedImpl df slabKind top sw] : new-glyph : glyph-proc
			local yBar : BarPos BODY-ROUND-TOP slabKind top
			include : difference
				Outer df BODY-ROUND-TOP top sw
				intersection [MaskRight df.middle] [MaskBelow (yBar - sw)]
			include : CrossBar df BODY-ROUND-TOP top sw
			include : ASerifs df top sw slabKind
			eject-contour 'serifRB'

		export : define [LetterBottomRightRemoved df bodyShape slabKind top sw] : match bodyShape
			([Just BODY-CURLY] || [Just BODY-STRAIGHT]) : begin
				return : CuspBottomRightRemovedImpl df bodyShape slabKind top sw
			[Just BODY-ROUND-TOP] : begin
				return : RoundTopBottomRightRemovedImpl df slabKind top sw

	glyph-block-export ASerifs
	define [ASerifs df top sw slabKind] : glyph-proc : begin
		local sf : SerifFrame.fromDf df top 0
		if [maskBits slabKind SLAB-LEFT] : include
			if ([maskBits slabKind SLAB-SMALL-CYRL] && para.isItalic) sf.lb.outer sf.lb.full
		if [maskBits slabKind SLAB-RIGHT] : include
			if ([maskBits slabKind SLAB-SMALL-CYRL] && para.isItalic) sf.rb.outer sf.rb.full
		if [maskBits slabKind SLAB-TOP] : include : tagged 'serifLT' : intersection [MaskLeft df.middle]
			if [maskBits slabKind : bitOr SLAB-LEFT SLAB-RIGHT]
			: then : HSerif.lt df.middle top (MidJutSide + [HSwToV : 0.25 * sw]) sf.swSerif
			: else : HSerif.lt df.middle top [mix MidJutSide LongJut 0.5]        sf.swSerif

	glyph-block-export AConfig
	define AConfig : SuffixCfg.weave
		object
			straight     BODY-STRAIGHT
			curly        BODY-CURLY
			roundTop     BODY-ROUND-TOP
		object
			serifless    SLAB-NONE
			topSerifed   SLAB-TOP
			baseSerifed  [bitOr SLAB-LEFT SLAB-RIGHT]
			triSerifed   [bitOr SLAB-TOP SLAB-LEFT SLAB-RIGHT]

	foreach { suffix { bodyShape slabKind } } [Object.entries AConfig] : do
		local fBarStraight : bodyShape === BODY-STRAIGHT
		local fSlabTop : maskBits slabKind SLAB-TOP
		local fSlabBot : maskBits slabKind [bitOr SLAB-LEFT SLAB-RIGHT]

		define [AShapeImpl mk top fTonos fSwash nOverlays] : glyph-proc
			include : MarkSet.(mk)
			set-base-anchor 'trailing' RightSB 0
			if fTonos : include : SetGrekUpperTonos : match bodyShape
				[Just BODY-ROUND-TOP] : begin 0
				__                    : (RightSB - SB) * [if fSlabTop 0.0 0.2]

			include : AShape.Letter [DivFrame 1] bodyShape slabKind top Stroke

			local yBar : AShape.BarPos bodyShape slabKind top

			if fSwash : begin
				eject-contour 'serifLT'
				local xBowlLeft : [mix 0 SB 0.5] - [HSwToV HalfStroke]
				local xTurn : xBowlLeft + [BowlXDepth top (yBar - Stroke) xBowlLeft Middle]
				include : difference
					dispiro
						widths.lhs
						flat Middle top [heading Leftward]
						curl [Arch.adjust-x.top xTurn] top
						archv
						g4   (xBowlLeft + OX) [YSmoothMidL top (yBar - Stroke)]
						arcvh
						flat [Arch.adjust-x.bot xTurn] (yBar - Stroke)
						curl Middle (yBar - Stroke) [heading Rightward]
					AShape.Mask [DivFrame 1] bodyShape top Stroke

			if nOverlays : match nOverlays
				[Just 1] : begin
					local yBot : if fSlabBot Stroke 0
					include : HOverlayBar [mix 0 SB 0.3] [mix Width RightSB 0.3]
						mix yBot (yBar - Stroke) 0.5
						Math.min OverlayStroke : 0.625 * (yBar - Stroke - yBot)
				[Just 2] : begin
					eject-contour 'crossBar'
					include : HOverlayBar [mix 0 SB 0.5] [mix Width RightSB 0.5] (yBar - (Stroke - OverlayStroke) / 2)
					include : HOverlayBar [mix 0 SB 0.5] [mix Width RightSB 0.5] [mix yBar top 0.25]

		create-glyph "A.\(suffix)"          : AShapeImpl "capital" CAP
		create-glyph "grek/Alpha.\(suffix)" : AShapeImpl "capital" CAP true
		create-glyph "smcpA.\(suffix)"      : AShapeImpl "e"       XH
		create-glyph "ABar.\(suffix)"       : AShapeImpl "capital" CAP false false 1
		if (bodyShape !== BODY-ROUND-TOP) : begin
			if (!fSlabTop) : create-glyph "ASwash.\(suffix)" : AShapeImpl "capital" CAP false true
			create-glyph "ASquare.\(suffix)" : glyph-proc
				local df : include : DivFrame [if fSlabTop para.advanceScaleT 1]
				local shift : df.middle - Middle
				include : with-transform [Translate shift 0] : glyph-proc
					include [refer-glyph "A.\(suffix)"]
					eject-contour 'serifLT'
				local xLeft : Math.min df.leftSB
					[mix 0     SB      : if fBarStraight VStraightSbShrink 1] - [if fBarStraight VStraightSbOffset 0] + shift
				local xRight : Math.max df.rightSB
					[mix Width RightSB : if fBarStraight VStraightSbShrink 1] + [if fBarStraight VStraightSbOffset 0] + shift
				local xTopBarLeft  : xLeft  + 0.75 * OX
				local xTopBarRight : xRight - 0.75 * OX
				include : HBar.t xTopBarLeft xTopBarRight CAP
				if fSlabTop : begin
					local swVJut : Math.min VJutStroke : df.adviceStroke 4.5
					include : tagged 'serifLT' : VSerif.dl xTopBarLeft  CAP VJut swVJut
					include : tagged 'serifRT' : VSerif.dr xTopBarRight CAP VJut swVJut

		create-glyph "currency/australSign.\(suffix)" : AShapeImpl "capital" CAP false false 2

	select-variant 'A' 'A'
	link-reduced-variant 'A/sansSerif' 'A' MathSansSerif
	select-variant 'smcpA'     0x1D00  (follow -- 'A')
	select-variant 'ABar'      0x1DF40 (follow -- 'A')
	select-variant 'ASwash'    0x1DF68 (follow -- 'AHookLeft')
	select-variant 'ARoundTop' 0x1DF6A (shapeFrom -- 'A') (follow -- 'A/roundTop')
	select-variant 'ASquare'   0x1DF80

	select-variant 'grek/Alpha' 0x391 (follow -- 'A')
	link-reduced-variant 'grek/Alpha/sansSerif' 'grek/Alpha' MathSansSerif (follow -- 'A/sansSerif')

	select-variant 'currency/australSign' 0x20B3 (follow -- 'A')

	alias 'cyrl/A' 0x410 'A'

	CreateAccentedComposition 'ARing' 0xC5 'A' 'ringAbove'

	CreateTurnedLetter 'turnA'  0x2C6F 'A'           HalfAdvance (CAP / 2)
	CreateTurnedLetter 'forall' 0x2200 'A/sansSerif' HalfAdvance (CAP / 2)

	glyph-block-import Letter-Blackboard : BBS BBD
	glyph-block-import Letter-Latin-V : BBVShape BBVInnerMaskShape

	create-glyph 'mathbb/A' 0x1D538 : glyph-proc
		include : MarkSet.capital
		include : union
			BBVShape SB RightSB 1 1 CAP
			intersection
				BBVInnerMaskShape SB RightSB 1 1 CAP
				HBar.t 0 Width (CAP - XH / 2) BBS
		include : FlipAround Middle (CAP / 2)
