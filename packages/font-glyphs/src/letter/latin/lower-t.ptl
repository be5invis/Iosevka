$$include '../../meta/macros.ptl'

import [mix clamp SuffixCfg] from "@iosevka/util"
import [DependentSelector] from "@iosevka/glyph/relation"

glyph-module

glyph-block Letter-Latin-Lower-T : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Mark-Adjustment : LeaningAnchor
	glyph-block-import Letter-Shared : CreateAccentedComposition CreateCommaCaronComposition
	glyph-block-import Letter-Shared : CreateDependentComposite CreateTurnedLetter
	glyph-block-import Letter-Shared-Shapes : CurlyTail FlatHookDepth ConnectedCedilla
	glyph-block-import Letter-Shared-Shapes : DiagTail TopHook PalatalHook
	glyph-block-import Letter-Shared-Shapes : SerifedArcEnd InwardSlabArcEnd
	glyph-block-import Letter-Latin-S : SAutoSlabEnd AdviceSArchDepth

	define SYM-LEFT          0
	define SYM-BALANCED      1
	define SYM-PR-LEFT       2
	define SYM-PR-BALANCED   3

	define dfN : DivFrame 1
	define dfF : DivFrame para.advanceScaleF 1 0.75

	define [xSmallTBarLeftT  df] : df.middle - df.adws * (df.adws * TBalance) - [HSwToV HalfStroke]
	define [xSmallTCrossRefT df] : [xSmallTBarLeftT df] + df.adws * TBalance2 + [HSwToV HalfStroke]

	define ySmallTBarPos XH

	glyph-block-export yShortNeck1 yShortNeck2
	define yShortNeck1 : clamp [mix XH Ascender 0.5] CAP : [mix XH Ascender 0.875] - Stroke * 0.125
	define yShortNeck2 : clamp [mix XH Ascender 0.5] CAP : [mix XH Ascender 0.750] - Stroke * 0.125

	define BentHook : namespace
		export : define [BarLeftPos df sym] : match sym
			[Just SYM-LEFT]     : mix df.leftSB [xSmallTBarLeftT df] 0.5
			[Just SYM-BALANCED] : xSmallTBarLeftT df
			__                  : df.middle - [HSwToV HalfStroke]

		define [xCrossBarPos df sym] : match sym
			([Just SYM-LEFT] || [Just SYM-PR-LEFT]) { ([BarLeftPos df sym] + TanSlope * Stroke) ([xSmallTCrossRefT df] + LongJut * [Math.sqrt df.adws]) }
			__                        { ([xSmallTCrossRefT df] - LongJut * [Math.sqrt df.adws]) ([xSmallTCrossRefT df] + LongJut * [Math.sqrt df.adws]) }

		define [xHookTerminal df sym] : match sym
			[Just SYM-LEFT] : begin df.rightSB
			__              : [BarLeftPos df sym] + [Math.max ((df.rightSB - df.leftSB) * 0.75 + [HSwToV QuarterStroke]) [HSwToV : 2.25 * Stroke]]

		export : define [Dims df sym] : begin
			define xLeft : BarLeftPos    df sym
			define xHook : xHookTerminal df sym
			return : object xLeft xHook [yHook Hook]
				ada [clamp Hook (1.2 * ([Arch.adjust-x.top [mix xLeft xHook 0.5]] - xLeft)) ArchDepthA]
				adb [clamp Hook (1.2 * ([Arch.adjust-x.bot [mix xLeft xHook 0.5]] - xLeft)) ArchDepthB]

		export : define [HookShapeT sink df sym offset top bot sw] : begin
			define [object xLeft xHook yHook adb] : Dims df sym

			return : sink
				widths.lhs sw
				[if (sink == spiro-outline) corner flat] (offset + xLeft) top [heading Downward]
				curl (offset + xLeft) (bot + adb)
				HookEnd (bot + offset) (sw -- sw)
				g4 (xHook - offset) (bot + yHook)
				if (sink == spiro-outline) { [corner (xHook - offset) top] } {}

		export : define [CrossBar df sym] : begin
			local {xcl xcr} : xCrossBarPos df sym
			return : HCrossBar.top xcl xcr ySmallTBarPos

		###########################################################################################

		export : define [Body df sym top bot] : glyph-proc
			include : CrossBar df sym

			local g : include : HookShapeT dispiro df sym 0 top bot Stroke
			local gEnd g.knots.(g.knots.length - 1)

			local xLeft : BarLeftPos df sym

			include : LeaningAnchor.Above.VBar.l xLeft
			include : LeaningAnchor.Below.Hook xLeft gEnd.x
			set-base-anchor 'hooktopAttach' (xLeft + [HSwToV HalfStroke]) top
			set-base-anchor 'bottomRight' gEnd.x gEnd.y
			set-base-anchor 'overlay' (g.knots.0.x + [HSwToV : 0.625 * Stroke]) [mix 0 XH 0.58]

		export : define [Retroflex df sym top bot] : FlatHook.Retroflex df sym top bot

	define NarrowBentHook : namespace
		export : define [BarLeftPos df sym] : BentHook.BarLeftPos df sym

		define [xCrossBarPos df sym] : begin
			local pAdaptive : if (para.advanceScaleF < 1) ((1 - df.adws) / (1 - para.advanceScaleF)) 0
			local narrowScaleLeft  : mix 0.820 0.870 pAdaptive
			local narrowScaleRight : mix 0.750 0.875 pAdaptive
			return : match sym
				([Just SYM-LEFT] || [Just SYM-PR-LEFT]) { ([BarLeftPos df sym] + TanSlope * Stroke) ([xSmallTCrossRefT df] + LongJut * narrowScaleRight * [Math.sqrt df.adws]) }
				__      { ([xSmallTCrossRefT df] - LongJut * narrowScaleLeft * [Math.sqrt df.adws]) ([xSmallTCrossRefT df] + LongJut * narrowScaleRight * [Math.sqrt df.adws]) }

		define [xHookTerminal df sym] : begin
			local pAdaptive : if (para.advanceScaleF < 1) ((1 - df.adws) / (1 - para.advanceScaleF)) 0
			return : match sym
				[Just SYM-LEFT] : mix [BarLeftPos df sym] df.rightSB [mix 0.75 1.00 pAdaptive]
				__              : [BarLeftPos df sym] + [Math.max ((df.rightSB - df.leftSB) * [mix 0.55 0.80 pAdaptive] + [HSwToV QuarterStroke]) [HSwToV : 2.25 * Stroke]]

		export : define [HookShapeT sink df sym offset top bot sw] : begin
			local xLeft : BarLeftPos df sym
			local xHook : xHookTerminal df sym
			local xTurn : Arch.adjust-x.bot [mix xLeft xHook 0.5]
			local adb : clamp Hook ((xTurn - xLeft) * 1.2) ArchDepthB
			local pAdaptive : if (para.advanceScaleF < 1) ((1 - df.adws) / (1 - para.advanceScaleF)) 0
			local swTerminal : mix sw [df.adviceStroke 2.75] [mix 0.35 0.10 pAdaptive]

			return : sink
				widths.lhs sw
				[if (sink == spiro-outline) corner flat] (offset + xLeft) top [heading Downward]
				curl (offset + xLeft) (bot + adb)
				HookEnd (bot + offset) (sw -- sw) (swTerminal -- swTerminal)
				g4 (xHook - offset) (bot + Hook)
				if (sink == spiro-outline) { [corner (xHook - offset) top] } {}

		export : define [CrossBar df sym] : begin
			local {xcl xcr} : xCrossBarPos df sym
			return : HCrossBar.top xcl xcr ySmallTBarPos

		###########################################################################################

		export : define [Body df sym top bot] : glyph-proc
			include : CrossBar df sym

			local g : include : HookShapeT dispiro df sym 0 top bot Stroke
			local gEnd g.knots.(g.knots.length - 1)

			local xLeft : BarLeftPos df sym

			include : LeaningAnchor.Above.VBar.l xLeft
			include : LeaningAnchor.Below.Hook xLeft gEnd.x
			set-base-anchor 'hooktopAttach' (xLeft + [HSwToV HalfStroke]) top
			set-base-anchor 'bottomRight' gEnd.x gEnd.y
			set-base-anchor 'overlay' (g.knots.0.x + [HSwToV : 0.625 * Stroke]) [mix 0 XH 0.58]

		export : define [Retroflex df sym top bot] : FlatHook.Retroflex df sym top bot

	define DiagonalTailed : namespace
		define [HookShape df sym top bot sw] : begin
			local xMid : [BarLeftPos df sym] + [HSwToV HalfStroke]
			local hookDepth : [if (sym === SYM-LEFT) 1.375 1] * [DiagTail.StdDepth [DivFrame : Math.sqrt df.adws] sw] - [HSwToV HalfStroke]
			return : dispiro
				flat       xMid top [widths.center.heading sw Downward]
				DiagTail.R xMid bot hookDepth sw

		###########################################################################################

		export : define BarLeftPos BentHook.BarLeftPos

		export : define [Body df sym top bot] : glyph-proc
			include : BentHook.CrossBar df sym

			local g : include : HookShape df sym top 0 Stroke

			local gEnd g.rhsKnots.(g.rhsKnots.length - 1)

			include : LeaningAnchor.Above.VBar.l [BarLeftPos df sym]
			include : LeaningAnchor.Below.VBar.l [BarLeftPos df sym] (2 * Stroke)
			set-base-anchor 'hooktopAttach' ([BarLeftPos df sym] + [HSwToV HalfStroke]) top
			set-base-anchor 'bottomRight' gEnd.x gEnd.y
			set-base-anchor 'overlay' (g.knots.0.x + [HSwToV : 0.125 * Stroke]) [mix 0 XH 0.58]

		export : define [Retroflex df sym top bot] : FlatHook.Retroflex df sym top bot

	define FlatHook : namespace
		export : define [xCrossBarPos df sym] : match sym
			([Just SYM-LEFT] || [Just SYM-PR-LEFT]) { ([BarLeftPos df sym] + TanSlope * Stroke) [mix df.width df.rightSB [mix 1 df.adws 2]] }
			__                                { [mix 0 [mix 0 df.leftSB 0.6] [mix 1 df.adws 2]] [mix df.width df.rightSB [mix 1 df.adws 2]] }

		define NORMAL    0
		define RETROFLEX 1
		define PR        2

		export : define [BarLeftPos df sym] : match sym
			[Just SYM-LEFT]      : mix df.leftSB [xSmallTBarLeftT df] 0.5
			[Just SYM-BALANCED]  : xSmallTBarLeftT df
			__                   : df.middle - [HSwToV HalfStroke]

		export : define [Body        df sym top bot] : Impl NORMAL    df sym top bot 0
		export : define [Retroflex   df sym top bot] : Impl RETROFLEX df sym top bot 0
		export : define [CrossRTBody df sym top bot] : Impl RETROFLEX df sym top bot 0

		define [Impl shape df sym top bot ext] : glyph-proc
			local xBarLeft : BarLeftPos df sym
			local {xCrossLeft xCrossRight} : xCrossBarPos df sym

			local hd : FlatHookDepth df
			define xTailEnd : match shape
				[Just RETROFLEX] : xBarLeft + HookX + [HSwToV HalfStroke]
				__               : begin xCrossRight

			include : union
				HCrossBar.top xCrossLeft (xCrossRight + ext) ySmallTBarPos
				dispiro
					widths.rhs
					if (shape === RETROFLEX)
						then : straight.left.start xTailEnd bot
						else : list
							flat xCrossRight bot
							curl [Math.min (xBarLeft + hd.x) (xCrossRight - 1)] bot
					archv.superness DesignParameters.tightHookSuperness
					flat xBarLeft [if (shape === RETROFLEX) (bot + Hook + HalfStroke) hd.y]
					curl xBarLeft top [heading Upward]

			include : LeaningAnchor.Above.VBar.l xBarLeft
			include : LeaningAnchor.Below.Hook xBarLeft xCrossRight
			set-base-anchor 'hooktopAttach' (xBarLeft + [HSwToV HalfStroke]) top
			set-base-anchor 'topRight' xCrossRight  Ascender
			set-base-anchor 'overlay' (xBarLeft + [HSwToV : 0.625 * Stroke]) [mix 0 XH 0.58]
			set-base-anchor 'bottomRight' xTailEnd bot
			set-base-anchor 'palatalHookAttach' xTailEnd (bot + Stroke)

	define UprightTailed : namespace
		export : define BarLeftPos FlatHook.BarLeftPos
		export : define [Body df sym top bot] : glyph-proc
			local {xCrossLeft xCrossRight} : FlatHook.xCrossBarPos df sym
			local xBarLeft : BarLeftPos df sym

			include : union
				HCrossBar.top xCrossLeft xCrossRight ySmallTBarPos
				dispiro
					widths.rhs
					flat xCrossRight bot
					curl xCrossRight top [heading Upward]
					flat xBarLeft top
					curl xBarLeft bot [heading Downward]


	define Hookless : namespace
		export : define [BarLeftPos df sym] : match sym
			[Just SYM-LEFT] : mix df.leftSB [xSmallTBarLeftT df] 0.5
			__              : df.middle - [HSwToV HalfStroke]

		define [xCrossBarPos df sym] : match sym
			([Just SYM-LEFT] || [Just SYM-PR-LEFT]) { ([BarLeftPos df sym] + TanSlope * Stroke) (df.middle + LongJut * [Math.sqrt df.adws]) }
			__                                    { (df.middle - LongJut * [Math.sqrt df.adws]) (df.middle + LongJut * [Math.sqrt df.adws]) }

		export : define [Body df sym top bot] : glyph-proc
			local xLeft : BarLeftPos df sym
			local { xcl xcr } : xCrossBarPos df sym
			local xEnd : xLeft + [HSwToV : 1.75 * Stroke]
			include : VBar.l xLeft 0 top
			include : HCrossBar.top xcl xcr ySmallTBarPos

			include : LeaningAnchor.Above.VBar.l xLeft
			include : LeaningAnchor.Below.VBar.l xLeft
			set-base-anchor 'overlay' (xLeft + [HSwToV HalfStroke]) [mix 0 XH 0.58]
			set-base-anchor 'hooktopAttach' (xLeft + [HSwToV HalfStroke]) top
			set-base-anchor 'bottomRight' xEnd (bot + Stroke)
			set-base-anchor 'palatalHookAttach' xEnd (bot + Stroke)

		export : define [Retroflex df sym top bot] : FlatHook.CrossRTBody df sym top bot

		export : define [PLBody df sym top bot] : glyph-proc
			local xLeft : BarLeftPos df sym
			include : Body df sym top bot
			include : HBar.b xLeft RightSB 0

	define SmallTConfig : SuffixCfg.weave
		object # body
			bentHook                       { dfN BentHook       }
			narrowBentHook                 { dfF NarrowBentHook }
			diagonalTailed                 { dfF DiagonalTailed }
			flatHook                       { dfF FlatHook       }
			hookless                       { dfF Hookless       }
		object # symmetry
			""                             SYM-BALANCED
			asymmetric                     SYM-LEFT
		object # height
			""                             Ascender
			shortNeck                      yShortNeck1
			shortNeck2                     yShortNeck2

	foreach { suffix { { df Style } sym top } } [pairs-of SmallTConfig] : do
		define fShortNeck : top < Ascender

		create-glyph "t.\(suffix)" : glyph-proc
			set-width df.width
			include : df.markSet.b
			include : Style.Body df sym top 0
			currentGlyph.copyBaseAnchorIfAbsent 'leaningAbove' 'above'
			currentGlyph.copyBaseAnchorIfAbsent 'leaningBelow' 'below'

		create-glyph "t/phoneticLeft2.\(suffix)" : glyph-proc
			set-width df.width
			include : df.markSet.b
			include : (Style.PLBody || Style.Body) df sym top 0

		create-glyph "t/phoneticLeft3.\(suffix)" : glyph-proc
			set-width dfN.width
			include : dfN.markSet.b
			include : Style.Body dfN sym top 0
			include : HCrossBar.top dfN.middle (dfN.width + dfN.middle) ySmallTBarPos

		if (!fShortNeck) : create-glyph "t/compLigRight.\(suffix)" : glyph-proc
			set-width df.width
			include : df.markSet.b
			include : difference
				Style.Body df (sym + SYM-PR-LEFT) top 0
				MaskLeft [mix df.leftSB (df.middle - [HSwToV HalfStroke]) 0.5]

		if (!fShortNeck) : create-glyph "tHookTop.\(suffix)" : glyph-proc
			include [refer-glyph "t.\(suffix)"] AS_BASE ALSO_METRICS
			local attach : currentGlyph.gizmo.unapply currentGlyph.baseAnchors.hooktopAttach
			currentGlyph.clearGeometry

			include : union
				difference [Style.Body df sym top 0] [MaskAbove XH]
				TopHook.toRight.mBarInner attach.x XH Ascender

		create-glyph "tRTail.\(suffix)" : glyph-proc
			set-width df.width
			include : df.markSet.bp
			include : Style.Retroflex df sym top Descender

		if (!fShortNeck) : create-glyph "tHookTopRTail.\(suffix)" : glyph-proc
			set-width df.width
			include : df.markSet.bp
			include : Style.Retroflex df sym XH Descender
			local attach : currentGlyph.gizmo.unapply currentGlyph.baseAnchors.hooktopAttach
			include : TopHook.toRight.mBarInner attach.x XH Ascender

		create-glyph "tPalatalHook.\(suffix)" : glyph-proc
			set-width df.width
			include : df.markSet.bp
			include : Style.Body df sym top 0

			local attach : currentGlyph.gizmo.unapply (currentGlyph.baseAnchors.palatalHookAttach || currentGlyph.baseAnchors.bottomRight)
			include : PalatalHook.r
				x -- attach.x
				y -- 0
				yAttach -- attach.y

		create-glyph "tCurlyTail.\(suffix)" : glyph-proc
			set-width dfN.width
			include : dfN.markSet.b

			local fine : AdviceStroke 3.5
			local xLeft : Style.BarLeftPos dfN sym

			include : difference
				Style.Body dfN sym top 0
				MaskBelow (ySmallTBarPos - Stroke - TINY)

			include : dispiro
				widths.lhs
				flat xLeft (ySmallTBarPos - Stroke) [heading Downward]
				curl xLeft (0 + LongVJut)
				CurlyTail.n fine 0 (xLeft + [HSwToV Stroke] + LongJut) 0 0

		if (!fShortNeck) : create-glyph "turntCurlyTail.\(suffix)" : glyph-proc
			set-width df.width
			include : df.markSet.b

			local fine : AdviceStroke2 3.5 2.5 (0 - Descender)
			local xRight : df.width - [Style.BarLeftPos df sym]

			include : new-glyph : composite-proc
				Style.Body df sym XH 0
				FlipAround df.middle (XH / 2)

			include : dispiro
				widths.rhs
				flat xRight TINY [heading Downward]
				curl xRight 0    [heading Downward]
				CurlyTail.n fine Descender (xRight - [HSwToV Stroke] - LongJut) df.rightSB Descender ([mix 0 Descender 0.5] + fine)


	select-variant 't' 't'
	select-variant 't/compLigRight'

	select-variant 't/phoneticLeft1' (shapeFrom -- 't')
	select-variant 't/phoneticLeft2'
	select-variant 't/phoneticLeft3' (follow -- 't')
	select-variant 't/phoneticLeft3/reduced' (shapeFrom -- 't/phoneticLeft3') (follow -- 't/phoneticLeft1')

	create-glyph 't/phoneticLeft4/selector.serifless' : glyph-proc
		local df : include dfN
		include : df.markSet.b
		DependentSelector.set currentGlyph 'full'

	create-glyph 't/phoneticLeft4/selector.serifed' : glyph-proc
		local df : include dfN
		include : df.markSet.b
		DependentSelector.set currentGlyph 'reduced'

	select-variant 't/phoneticLeft4/selector' (follow -- 'l/bottomSerif/leftHalf')

	CreateDependentComposite 't/phoneticLeft4' null 't/phoneticLeft4/selector' : object
		'full'    't/phoneticLeft3'
		'reduced' 't/phoneticLeft3/reduced'

	CreateCommaCaronComposition 'tCaron' 0x165 't'
	CreateAccentedComposition 'tWedge' null 't' 'caronAbove'

	derive-glyphs 'tCedilla' 0x163 't' ConnectedCedilla
	CreateAccentedComposition 'tComma' 0x21B 't' 'commaBelow'

	select-variant 'tPalatalHook' 0x1AB (follow -- 't')

	select-variant 'tHookTop'      0x1AD
	select-variant 'tRTail'        0x288
	select-variant 'tHookTopRTail' 0x1DF09

	CreateTurnedLetter 'turnt' 0x287 't' HalfAdvance (XH / 2)

	select-variant 'tCurlyTail'     0x236
	select-variant 'turntCurlyTail' 0x1DF0D (follow -- 'tHookTop')

	define ClosedTConfig : object
		hookless            { SYM-BALANCED }
		hooklessAsymmetric  { SYM-LEFT     }

	foreach { suffix { sym } } [pairs-of ClosedTConfig] : do
		create-glyph "tClosed.\(suffix)" : glyph-proc
			local df : include dfN
			include : df.markSet.b

			define [object xLeft xHook yHook ada adb] : BentHook.Dims df sym

			include : LeaningAnchor.Above.Hook xLeft xHook
			include : LeaningAnchor.Below.Hook xLeft xHook
			set-base-anchor 'bottomRight' xHook yHook
			set-base-anchor 'overlay' (xLeft + [HSwToV HalfStroke]) [mix 0 XH 0.58]

			include : intersection
				BentHook.CrossBar df sym
				MaskLeft [mix (xLeft + [HSwToV Stroke]) (xHook - [HSwToV Stroke]) : StrokeWidthBlend 0.9 0.7]
			include : dispiro
				widths.lhs
				flatside.ld xLeft 0 Ascender ada adb 0
				Arch.lhs 0
				g4   (xHook - OX) [YSmoothMidR Ascender 0 SmallArchDepthA SmallArchDepthB]
				Arch.lhs Ascender
				flatside.ld xLeft 0 Ascender ada adb 0

	select-variant 'th' 0x1DF79 (shapeFrom -- 'tClosed') (follow -- 'tHookTopRTail')

	# U+01BE is actually "t" and "s" combined together
	define SLAB-NONE        0
	define SLAB-CLASSICAL   1
	define SLAB-INWARD      2
	define [TsLigStrokeShape df stroke top sb] : begin
		define archDepth : AdviceSArchDepth (XH + 0.5 * ArchDepth) (-1) stroke
		return : dispiro
			widths.lhs stroke
			flat [xSmallTBarLeftT df] top [heading Downward]
			curl [xSmallTBarLeftT df] XH  [heading Downward]
			alsoThru.g2 0.5 0.5 [widths.center stroke]
			g4   df.rightSB (0 + archDepth) [widths.rhs stroke]
			match sb
				[Just SLAB-CLASSICAL] : SerifedArcEnd.RtlRhs df.leftSB 0 stroke SHook
				[Just SLAB-INWARD] : InwardSlabArcEnd.RtlRhs df.leftSB 0 stroke SHook
				__ : list
					HookEnd 0 (sw -- stroke)
					g4   df.leftSB (0 + SHook)

	define TSUpperConfig : object
		bentHook            { Ascender    }
		bentHookShortNeck   { yShortNeck1 }
		bentHookShortNeck2  { yShortNeck2 }

	foreach { suffix { top } } [Object.entries TSUpperConfig] : do
		create-glyph "tsLig/upperHalf.\(suffix)" : glyph-proc
			local df : include : DivFrame 1
			set-base-anchor 'cvDecompose' 0 0
			include : difference
				TsLigStrokeShape df Stroke top false
				MaskBelow XH
			include : BentHook.CrossBar df SYM-BALANCED

	define TSLowerConfig : object
		serifless               { SLAB-NONE      }
		bilateralSerifed        { SLAB-CLASSICAL }
		bilateralInwardSerifed  { SLAB-INWARD    }

	foreach { suffix { doBS } } [Object.entries TSLowerConfig] : do
		create-glyph "tsLig/lowerHalf.\(suffix)" : glyph-proc
			local df : include : DivFrame 1
			include : df.markSet.b
			set-mark-anchor 'cvDecompose' 0 0
			include : intersection
				TsLigStrokeShape df Stroke Ascender doBS
				MaskBelow XH
			include : SAutoSlabEnd df doBS 0  Stroke Hook

	select-variant 'tsLig/upperHalf'
	select-variant 'tsLig/lowerHalf'

	derive-composites "tsLig" 0x1BE 'tsLig/upperHalf' 'tsLig/lowerHalf'

	glyph-block-import Letter-Blackboard : BBS BBD
	create-glyph 'mathbb/t' 0x1D565 : glyph-proc
		define df : DivFrame 1
		include : df.markSet.b
		define xLeft : xSmallTBarLeftT df
		include : HBar.t xLeft (xLeft + BBD) Ascender BBS
		include : BentHook.HookShapeT dispiro df SYM-BALANCED 0 Ascender 0 BBS
		include : intersection
			VBar.l (xLeft + BBD) 0 Ascender BBS
			BentHook.HookShapeT spiro-outline df SYM-BALANCED 1 Ascender 0 BBS
		include : difference
			HCrossBar.top
				xLeft + (BBD / 2) - LongJut + TBalance2
				xLeft + (BBD / 2) + LongJut + TBalance2
				begin ySmallTBarPos
				begin BBS
			Rect Ascender 0 xLeft (xLeft + BBD)
