$$include '../../meta/macros.ptl'

import [mix] from "@iosevka/util"
import [Box] from "@iosevka/geometry/box"

glyph-module

glyph-block Letter-Greek-Lower-Zeta : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Mark-Adjustment : ExtendBelowBaseAnchors
	glyph-block-import Letter-Arc-Hook : Flat
	glyph-block-import Letter-Shared-Shapes : CyrDescender CyrTailDescender

	define TAIL-CURLY                 0
	define TAIL-STRAIGHT              1
	define TAIL-DIAGONAL              2
	define TAIL-STRAIGHT-SHARP-CORNER 3
	define TAIL-DIAGONAL-SHARP-CORNER 4

	define TailBot : (-LongVJut) + QuarterStroke
	define [TailBendX] : [Math.max (0.5 * Hook) : HSwToV Stroke] + [Math.max TightBendInnerRadius : HSwToV QuarterStroke]
	define [TailBendY] : [Math.max (0.5 * Hook)          Stroke] + [Math.max TightBendInnerRadius          QuarterStroke]

	define [StraightTailKnots yHoriz xDown wHoriz] : begin
		local xTurn : xDown - [TailBendX]
		local yCorner : yHoriz - [TailBendY]
		return : list
			arcvh.superness DesignParameters.tightHookSuperness
			flat [Math.min (xTurn - TanSlope * Stroke) : Arch.adjust-x.bot [mix SB RightSB 0.55] Stroke] yHoriz wHoriz
			curl xTurn yHoriz [heading Rightward]
			archv.superness DesignParameters.tightHookSuperness
			flat xDown yCorner [heading Downward]
			curl xDown TailBot [heading Downward]

	define [DiagonalTailKnots yHoriz xDown wHoriz] : begin
		local xTurn : xDown - [TailBendX]
		local yCorner : yHoriz - [TailBendY]
		local xDiagEnd : xDown + [mix 0 Descender 0.24]
		return : list
			arcvh.superness DesignParameters.tightHookSuperness
			flat [Math.min (xTurn - TanSlope * Stroke) : Arch.adjust-x.bot [mix SB RightSB 0.55] Stroke] yHoriz wHoriz
			curl xTurn yHoriz [heading Rightward]
			archv.superness DesignParameters.tightHookSuperness
			flat xDown yCorner [widths.rhs Stroke]
			curl xDiagEnd TailBot

	define [CurlyTailKnots] : begin
		local yCurlMid : mix Descender Stroke 0.5
		local hookIn : Math.max
			(Stroke - yCurlMid) * 1.1
			[HSwToV Stroke] + [Math.max TightBendInnerDiameter HalfStroke]
		return : list
			arcvh 16
			g2 [mix SB RightSB 0.55] Stroke [heading Rightward]
			archv 16
			g4.down.mid RightSB yCurlMid [heading Downward]
			arcvh 16
			flat (RightSB - hookIn) Descender
			curl [Math.min (RightSB - hookIn - 1) [mix SB RightSB 0.5]] Descender

	define [ZetaShape tail] : glyph-proc
		local fine : AdviceStroke 3
		include : HBar.m SB RightSB (Ascender - HalfStroke)

		local box : new Box Stroke 0 SB RightSB
		local Arc : Flat box (sw -- Stroke)

		include : dispiro
			g4 RightSB (Ascender - Stroke) [widths.rhs fine]
			bezControls 0.7 0.35 1 0.64 12
			g4.down.mid (SB + [HSwToV Stroke]) [mix 0 Ascender (0.54 * SmallArchDepthB / (SmallArchDepthA + SmallArchDepthB))] [widths.rhs Stroke]
			match tail
				[Just TAIL-CURLY] : CurlyTailKnots
				[Just TAIL-STRAIGHT] : StraightTailKnots Stroke RightSB [widths.rhs.heading Stroke Rightward]
				[Just TAIL-DIAGONAL] : DiagonalTailKnots Stroke RightSB [widths.rhs.heading Stroke Rightward]
				__ : list
					arcvh.superness DesignParameters.tightHookSuperness
					flat [Math.min (Arc.xRHook - TanSlope * Stroke) : Arch.adjust-x.top [mix Arc.xLArc Arc.xRArc 0.55] Stroke] Stroke [widths.rhs.heading Stroke Rightward]
					corner Arc.xRHook Stroke
		include : match tail
			([Just TAIL-STRAIGHT] || [Just TAIL-DIAGONAL]) : ExtendBelowBaseAnchors TailBot
			[Just TAIL-STRAIGHT-SHARP-CORNER] : CyrDescender.r     RightSB 0 RightSB
			[Just TAIL-DIAGONAL-SHARP-CORNER] : CyrTailDescender.r RightSB 0 RightSB
			__ : begin [glyph-proc]

	define ZetaConfig : object
		curlyTail               { TAIL-CURLY                 'bp' }
		straightTail            { TAIL-STRAIGHT              'b'  }
		diagonalTail            { TAIL-DIAGONAL              'b'  }
		straightTailSharpCorner { TAIL-STRAIGHT-SHARP-CORNER 'b'  }
		diagonalTailSharpCorner { TAIL-DIAGONAL-SHARP-CORNER 'b'  }

	foreach { suffix { tail mk } } [Object.entries ZetaConfig] : do
		create-glyph "grek/zeta.\(suffix)" : glyph-proc
			include : MarkSet.(mk)
			include : ZetaShape tail

	select-variant 'grek/zeta' 0x3B6
