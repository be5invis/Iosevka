$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback] from "@iosevka/util"
import [DesignParameters] from "../../meta/aesthetics.mjs"

glyph-module

glyph-block Letter-Greek-Lower-Xi : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives

	define SHAPE-ROUNDED  0
	define SHAPE-FLAT-TOP 1

	define pyBar 0.55

	define [LowerXiShape shape] : glyph-proc
		local adaTop : ArchDepthAOf : ArchDepth * (1 - pyBar)
		local adbTop : ArchDepthBOf : ArchDepth * (1 - pyBar)
		local adaBot : ArchDepthAOf : ArchDepth * (0 + pyBar)
		local adbBot : ArchDepthBOf : ArchDepth * (0 + pyBar)

		local fineMid : Stroke * CThin
		local fineTop : Stroke * CThinB
		local xBarStart : mix SB RightSB : match shape
			[Just SHAPE-ROUNDED]  0.625
			[Just SHAPE-FLAT-TOP] 0.750
		local xBarEnd : mix SB RightSB : match shape
			[Just SHAPE-ROUNDED]  0.750
			[Just SHAPE-FLAT-TOP] 0.850
		local yBarTop : mix Stroke Ascender pyBar
		local yBarBot : yBarTop - Stroke

		local xUpperArcLeft : match shape
			[Just SHAPE-ROUNDED]  :      SB                + 0
			[Just SHAPE-FLAT-TOP] : [mix SB RightSB 0.075] + OX
		local xLowerArcLeft : match shape
			[Just SHAPE-ROUNDED]  :      SB                + OX * 2
			[Just SHAPE-FLAT-TOP] : [mix SB RightSB 0.025] + OX * 2

		include : match shape
			[Just SHAPE-FLAT-TOP] : HBar.t SB RightSB Ascender
			__                    : glyph-proc

		include : dispiro
			match shape
				[Just SHAPE-ROUNDED] : list
					g4   (RightSB + O) (Ascender - Hook) [widths.lhs]
					HookStart Ascender
				[Just SHAPE-FLAT-TOP] : list
					flat                    xBarEnd    ((Ascender - Stroke) + fineTop) [widths.lhs fineTop]
					curl [Arch.adjust-x.top xBarStart] ((Ascender - Stroke) + fineTop) [widths.lhs fineTop]
					archv 16
			g4   xUpperArcLeft [YSmoothMidL Ascender yBarBot adaTop adbTop] [widths.lhs]
			arcvh 16
			flat [Arch.adjust-x.bot xBarStart] (yBarTop - fineMid) [widths.lhs.heading fineMid Rightward]
			curl                    xBarEnd    (yBarTop - fineMid) [widths.lhs.heading fineMid Rightward]
		include : dispiro
			flat                    xBarEnd    (yBarBot + fineMid) [widths.lhs.heading fineMid Leftward]
			curl [Arch.adjust-x.top xBarStart] (yBarBot + fineMid) [widths.lhs.heading fineMid Leftward]
			archv 16
			g4   xLowerArcLeft [mix 0 [YSmoothMidL yBarTop 0 adaBot adbBot] 0.9] [widths.lhs]
			arcvh 16
			g4   [mix (xLowerArcLeft + [HSwToV Stroke]) (RightSB - [HSwToV Stroke]) 0.6] 0 [heading Rightward]
			archv 16
			g4.down.mid (RightSB - [HSwToV Stroke]) [mix Descender Stroke 0.5] [heading Downward]
			arcvh 16
			flat                    (RightSB - (Stroke - [mix Descender Stroke 0.5]) * 1.1)      (Descender + Stroke)
			curl [Math.min Middle : (RightSB - (Stroke - [mix Descender Stroke 0.5]) * 1.1) - 1] (Descender + Stroke)

	create-glyph : glyph-proc
		include : MarkSet.bp
		create-forked-glyph "grek/xi.flatTop" : LowerXiShape SHAPE-FLAT-TOP
		create-forked-glyph "grek/xi.rounded" : LowerXiShape SHAPE-ROUNDED

	select-variant 'grek/xi' 0x3BE
