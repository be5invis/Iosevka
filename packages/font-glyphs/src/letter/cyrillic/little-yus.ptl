$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback] from "@iosevka/util"

glyph-module

glyph-block Letter-Cyrillic-Little-Yus : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Letter-Shared-Shapes : SerifFrame
	glyph-block-import Letter-Latin-Upper-A : AShape
	glyph-block-import Letter-Latin-Upper-Lambda-Delta : LambdaShape DeltaShape
	glyph-block-import Letter-Cyrillic-Iotated : Iotation

	define [CyrLittleYusShape df top straightBar _fine] : glyph-proc
		local fine : fallback _fine : df.adviceThinnerStroke 3.3
		include : LambdaShape
			df           -- df
			fBarStraight -- straightBar
			slabKind     -- 0
			top          -- top
			sw           -- fine
		include : intersection
			HBar.t df.leftSB df.rightSB [mix 0 top 0.5] fine
			AShape.Mask df [if straightBar 1 0] top fine
		include : VBar.m df.middle [mix 0 top 0.5] 0 fine

		if SLAB : begin
			local sf : SerifFrame.fromDf df top 0 (swSerif -- fine)
			include : tagged 'serifLB' sf.lb.outer
			include : tagged 'serifRB' sf.rb.outer
			if sf.enoughSpaceForFullSerifs
				include : tagged 'serifMB' sf.mb.full

	define [CyrClosedLittleYusShape df top straightBar _fine] : glyph-proc
		local fine : fallback _fine : df.adviceThinnerStroke 2.75
		include : DeltaShape
			df           -- df
			top          -- top
			bottom       -- 0
			sw           -- fine
			fBarStraight -- straightBar
			slab         -- false
		include : intersection
			HBar.t df.leftSB df.rightSB [mix 0 top 0.5] fine
			AShape.Mask df [if straightBar 1 0] top fine

		if SLAB : begin
			local sf : SerifFrame.fromDf df top 0 (swSerif -- fine)
			include : tagged 'serifLB' sf.lb.outer
			include : tagged 'serifRB' sf.rb.outer

	create-glyph : glyph-proc
		local df : include : DivFrame para.advanceScaleM 3
		include : df.markSet.capital
		create-forked-glyph 'cyrl/YusLittle.straight' : CyrLittleYusShape df CAP true
		create-forked-glyph 'cyrl/YusLittle.curly'    : CyrLittleYusShape df CAP false

	create-glyph : glyph-proc
		local df : include : DivFrame 1 3
		include : df.markSet.e
		create-forked-glyph 'cyrl/yusLittle.straight' : CyrLittleYusShape df XH true
		create-forked-glyph 'cyrl/yusLittle.curly'    : CyrLittleYusShape df XH false

	create-glyph : glyph-proc
		local df : include : DivFrame para.advanceScaleM 2
		include : df.markSet.capital
		create-forked-glyph 'cyrl/YusLittleClosed.straight' : CyrClosedLittleYusShape df CAP true
		create-forked-glyph 'cyrl/YusLittleClosed.curly'    : CyrClosedLittleYusShape df CAP false

	create-glyph : glyph-proc
		local df : include : DivFrame 1 2
		include : df.markSet.e
		create-forked-glyph 'cyrl/yusLittleClosed.straight' : CyrClosedLittleYusShape df XH true
		create-forked-glyph 'cyrl/yusLittleClosed.curly'    : CyrClosedLittleYusShape df XH false

	select-variant 'cyrl/YusLittle' 0x466 (follow -- 'cyrl/Yus')
	select-variant 'cyrl/yusLittle' 0x467 (follow -- 'cyrl/Yus')
	select-variant 'cyrl/YusLittleClosed' 0xA658 (follow -- 'cyrl/Yus')
	select-variant 'cyrl/yusLittleClosed' 0xA659 (follow -- 'cyrl/Yus')

	define [CyrIotatedLittleYusShape fClosed fCapital df top straightBar] : glyph-proc
		local scalar : if fCapital 0.80 0.75
		local fine : df.adviceThinnerStroke [if fClosed 2.75 3.3] scalar
		local gap : (df.rightSB - df.leftSB) / 3 - [if fClosed 0 : fine / 3]
		local subDf : DivFrame [Math.min ((df.width - gap) / Width) (df.adws * scalar)] [if fClosed 2 3]

		local shift : df.width - subDf.width
		local xIotaRight : df.leftSB + [HSwToV fine]
		local botGap : Math.max (0.08 * (df.rightSB - df.leftSB)) : AdviceStroke 6
		include : difference
			with-transform [ApparentTranslate shift 0] : if fClosed
				CyrClosedLittleYusShape subDf top straightBar fine
				CyrLittleYusShape       subDf top straightBar fine
			intersection
				MaskBelow fine
				MaskLeft [mix xIotaRight [Math.min (subDf.leftSB + shift) (xIotaRight + botGap)] 0.5]

		include : Iotation.A df top
			hBarRight -- [mix df.leftSB df.rightSB (2 / 3)]
			hBarY     -- ([mix 0 top 0.5] - fine / 2)
			fCapital  -- fCapital
			swRef     -- fine

	create-glyph : glyph-proc
		local df : include : DivFrame [mix 1 para.advanceScaleM 2] 4.25
		include : df.markSet.capital
		create-forked-glyph 'cyrl/YusLittleIotated.straight' : CyrIotatedLittleYusShape false true df CAP true
		create-forked-glyph 'cyrl/YusLittleIotated.curly'    : CyrIotatedLittleYusShape false true df CAP false

	create-glyph : glyph-proc
		local df : include : DivFrame para.advanceScaleM 4.25
		include : df.markSet.e
		create-forked-glyph 'cyrl/yusLittleIotated.straight' : CyrIotatedLittleYusShape false false df XH true
		create-forked-glyph 'cyrl/yusLittleIotated.curly'    : CyrIotatedLittleYusShape false false df XH false

	create-glyph : glyph-proc
		local df : include : DivFrame [mix 1 para.advanceScaleM 2] 3.5
		include : df.markSet.capital
		create-forked-glyph 'cyrl/YusLittleClosedIotated.straight' : CyrIotatedLittleYusShape true true df CAP true
		create-forked-glyph 'cyrl/YusLittleClosedIotated.curly'    : CyrIotatedLittleYusShape true true df CAP false

	create-glyph : glyph-proc
		local df : include : DivFrame para.advanceScaleM 3.5
		include : df.markSet.e
		create-forked-glyph 'cyrl/yusLittleClosedIotated.straight' : CyrIotatedLittleYusShape true false df XH true
		create-forked-glyph 'cyrl/yusLittleClosedIotated.curly'    : CyrIotatedLittleYusShape true false df XH false

	select-variant 'cyrl/YusLittleIotated' 0x468 (follow -- 'cyrl/Yus')
	select-variant 'cyrl/yusLittleIotated' 0x469 (follow -- 'cyrl/Yus')
	select-variant 'cyrl/YusLittleClosedIotated' 0xA65C (follow -- 'cyrl/Yus')
	select-variant 'cyrl/yusLittleClosedIotated' 0xA65D (follow -- 'cyrl/Yus')
