$$include '../../meta/macros.ptl'

import [mix linreg clamp fallback] from "@iosevka/util"

glyph-module

glyph-block Letter-Latin-Upper-Insular-D : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives

	define fine : mix ShoulderFine Stroke 0.125

	create-glyph 'DInsular' 0xA779 : glyph-proc
		include : MarkSet.capital
		include : union
			dispiro
				widths.lhs fine
				flat (Middle - O + [Math.abs : Stroke * TanSlope]) (CAP - O - (Stroke - fine))
				curl [Arch.adjust-x.top Middle (sw -- fine)]       (CAP - O - (Stroke - fine))
				archv
				flatside.ld SB      0 CAP ArchDepthA ArchDepthB 0 [widths.lhs]
				Arch.lhs 0
				flatside.ru RightSB 0 CAP ArchDepthA ArchDepthB 0
				arcvh
				straight.left.end [Arch.adjust-x.top Middle] (CAP - O)
			dispiro
				widths.lhs [AdviceStroke 3]
				flat [Arch.adjust-x.top Middle] (CAP - O)
				curl [mix SB 0 0.5] (CAP - O)
