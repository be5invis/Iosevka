$$include '../meta/macros.ptl'

import [mix linreg clamp fallback] from "@iosevka/util"

glyph-module

glyph-block Mark-Horn-And-Angle : begin
	glyph-block-import CommonShapes
	glyph-block-import Common-Derivatives
	glyph-block-import Mark-Shared-Metrics : markMiddle markExtend markStroke markHalfStroke
	glyph-block-import Mark-Shared-Metrics : markStress markFine markDotsRadius commaRadius
	glyph-block-import Mark-Above : aboveMarkTop aboveMarkBot aboveMarkMid aboveMarkStack CyrKavykaShape
	glyph-block-import Mark-Below : belowMarkBot belowMarkTop belowMarkMid belowMarkStack

	### Horn and angle marks

	glyph-block-export Horn
	define [Horn attX attY overflowX overflowY krX krY] : namespace
		export : define [dim] : begin
			local radius commaRadius
			local fine   : Math.min (radius * 0.75) (markFine * 1.75)
			local stroke : Math.min (radius * 1.00) (markFine * 1.75)
			local startX : attX + krX * radius
			local startY : attY + krY * radius + [Math.sign krY] * (aboveMarkTop - aboveMarkBot) / 2
			return : object radius fine stroke startX startY

		export : define anchor : namespace
			export : define [mark] : glyph-proc
				local [object radius fine startX startY] : dim
				set-mark-anchor 'topRight' attX attY startX startY
				set-base-anchor 'aboveBraceL' (startX - radius) startY
				set-base-anchor 'aboveBraceR' (startX - radius) startY

			export : define [base] : glyph-proc
				local [object radius fine startX startY] : dim
				set-base-anchor 'topRight' startX startY
				set-base-anchor 'aboveBraceL' (startX - radius) startY
				set-base-anchor 'aboveBraceR' (startX - radius) startY

		export : define shape : namespace
			export : define [round] : glyph-proc
				local [object radius fine stroke startX startY] : dim
				include : union
					RingAt (startX - radius) startY (radius - fine / 8)
					dispiro
						widths.rhs (fine / 4)
						g4 (startX + OX) (startY)
						arcvh
						g4 (startX - radius * 1) (startY - radius)
						archv
						g4 (startX - radius * 2) (startY)
						arcvh
						g4 (startX - radius * 1) (startY + radius) [widths.rhs (fine / 2)]
						archv
						g4 startX startY [widths.rhs fine]
						quadControls 0 0.75 16 : object : blend : lambda [t] : widths.rhs [mix fine stroke t]
						g4 (attX - overflowX - [HSwToV HalfStroke]) (attY - overflowY - Stroke) [widths.rhs stroke]

			export : define [square] : glyph-proc
				local [object [radius r] fine stroke startX startY] : dim
				local radius : r * SquareDotScalar
				include : union
					SquareAt (startX - radius) startY radius
					dispiro
						widths.rhs fine
						flat startX (startY + radius) [heading Downward]
						curl startX (startY - radius)
						quadControls 0 0.8 8 : object : blend : lambda [t] : widths.rhs [mix fine stroke t]
						g4 (attX - overflowX - [HSwToV HalfStroke]) (attY - overflowY - Stroke) [widths.rhs stroke]

	create-glyph : glyph-proc
		set-width 0
		local horn : Horn 0 XH 0 0 (+2.0) (+0.5)
		include : horn.anchor.mark
		create-forked-glyph "horn.round"  : horn.shape.round
		create-forked-glyph "horn.square" : horn.shape.square

	select-variant 'horn' 0x31B (follow -- 'diacriticDot')

	create-glyph : glyph-proc
		set-width 0
		local horn : Horn 0 XH Middle ArchDepthB (+2.0) (+0.5)
		include : horn.anchor.mark
		create-forked-glyph "longHorn.round"  : horn.shape.round
		create-forked-glyph "longHorn.square" : horn.shape.square

	select-variant 'longHorn' null (follow -- 'diacriticDot')

	create-glyph 'leftAngleTR' 0x31A : glyph-proc
		set-width 0
		include : VBar.l 0 aboveMarkBot aboveMarkTop (markFine * 2)
		include : HBar.t ((-1.5) * markExtend) 0 aboveMarkTop (markFine * 2)
		set-mark-anchor 'topRight' 0 XH 0 aboveMarkTop
		set-base-anchor 'aboveBraceL' ((-0.75) * markExtend) aboveMarkMid
		set-base-anchor 'aboveBraceR' 0 aboveMarkMid

	create-glyph 'palatalHookBR' 0x321 : glyph-proc
		set-width 0
		set-mark-anchor 'bottomRight' 0 0 0 belowMarkBot
		set-base-anchor 'belowBraceL' ((-0.5) * HookX - 0.25 * markExtend - [HSwToV : 0.25 * Stroke]) ((-0.5) * Hook - HalfStroke)
		set-base-anchor 'belowBraceR' ((-0.5) * HookX + 0.25 * markExtend - [HSwToV : 0.25 * Stroke]) ((-0.5) * Hook - HalfStroke)
		include : dispiro
			widths.rhs
			flat 0 (-O) [heading Downward]
			curl 0 0 [heading Downward]
			straight.left.end ((-HookX) - [HSwToV HalfStroke]) ((-Hook) - HalfStroke)

	create-glyph 'retroflexHookBR' 0x322 : glyph-proc
		set-width 0
		set-mark-anchor 'bottomRight' 0 0 0 belowMarkBot
		set-base-anchor 'belowBraceL' ((+0.5) * HookX - 0.25 * markExtend - [HSwToV : 0.75 * Stroke]) ((-0.5) * Hook - HalfStroke)
		set-base-anchor 'belowBraceR' ((+0.5) * HookX + 0.25 * markExtend - [HSwToV : 0.50 * Stroke]) ((-0.5) * Hook - HalfStroke)
		include : dispiro
			widths.rhs
			flat 0 (-O) [heading Downward]
			curl 0 0 [heading Downward]
			straight.right.end ((+HookX) - [HSwToV HalfStroke]) ((-Hook) + HalfStroke)

	foreach { suffix { DrawAt kdr } } [Object.entries DotVariants] : do
		create-glyph "dotTR.\(suffix)" : glyph-proc
			set-width 0
			local horn : Horn (-0) aboveMarkBot 0 0 (+2.0) (+1.0)
			local [object radius startX] : horn.dim
			local r : mix radius DotRadius 0.5
			set-mark-anchor 'topRight' (-0) XH startX aboveMarkStack
			set-base-anchor 'aboveBraceL' (startX - r) aboveMarkMid
			set-base-anchor 'aboveBraceR' (startX - r) aboveMarkMid
			include : DrawAt (startX - r) aboveMarkMid (r * kdr)

		create-glyph "dotTL.\(suffix)" : glyph-proc
			set-width 0
			local horn : Horn (-Width) aboveMarkBot 0 0 (-2.0) (+1.0)
			local [object radius startX] : horn.dim
			local r : mix radius DotRadius 0.5
			set-mark-anchor 'topLeft' (-Width) XH startX aboveMarkStack
			set-base-anchor 'aboveBraceL' (startX + r) aboveMarkMid
			set-base-anchor 'aboveBraceR' (startX + r) aboveMarkMid
			include : DrawAt (startX + r) aboveMarkMid (r * kdr)

		create-glyph "dotBR.\(suffix)" : glyph-proc
			set-width 0
			local horn : Horn (-0) belowMarkTop 0 0 (+2.0) (-1.0)
			local [object radius startX] : horn.dim
			local r : mix radius DotRadius 0.5
			set-mark-anchor 'bottomRight' (-0) 0 startX belowMarkStack
			set-base-anchor 'belowBraceL' (startX - r) belowMarkMid
			set-base-anchor 'belowBraceR' (startX - r) belowMarkMid
			include : DrawAt (startX - r) belowMarkMid (r * kdr)

		create-glyph "dotBL.\(suffix)" : glyph-proc
			set-width 0
			local horn : Horn (-Width) belowMarkTop 0 0 (-2.0) (-1.0)
			local [object radius startX] : horn.dim
			local r : mix radius DotRadius 0.5
			set-mark-anchor 'bottomLeft' (-Width) 0 startX belowMarkStack
			set-base-anchor 'belowBraceL' (startX + r) belowMarkMid
			set-base-anchor 'belowBraceR' (startX + r) belowMarkMid
			include : DrawAt (startX + r) belowMarkMid (r * kdr)

	select-variant 'dotTR' 0x358  (follow -- 'diacriticDot')
	select-variant 'dotTL' 0x1DF8 (follow -- 'diacriticDot')
	select-variant 'dotBR'        (follow -- 'diacriticDot')
	select-variant 'dotBL' 0x1DFA (follow -- 'diacriticDot')

	derive-glyphs 'commaTR' 0x315 'commaAbove' : function [src gr] : glyph-proc
		set-width 0

		include : refer-glyph src
		include : ApparentTranslate ((RightSB + DotRadius) - Middle) 0
		currentGlyph.clearAnchors

		set-mark-anchor 'topRight' (markMiddle + (RightSB - SB) / 2) XH (markMiddle + (RightSB - SB) / 2 + DotRadius) aboveMarkTop
		set-base-anchor 'aboveBraceL' (markMiddle + (RightSB - SB) / 2 + DotRadius) aboveMarkMid
		set-base-anchor 'aboveBraceR' (markMiddle + (RightSB - SB) / 2 + DotRadius) aboveMarkMid

	derive-glyphs 'commaTL/asPunctuation' null 'commaAbove/asPunctuation' : function [src gr] : glyph-proc
		set-width 0

		include : refer-glyph src
		include : ApparentTranslate ((SB - DotRadius) - Middle) 0
		currentGlyph.clearAnchors

		set-mark-anchor 'topLeft' (markMiddle - (RightSB - SB) / 2) XH (markMiddle - (RightSB - SB) / 2 - DotRadius) aboveMarkTop
		set-base-anchor 'aboveBraceL' (markMiddle - (RightSB - SB) / 2 - DotRadius) aboveMarkMid
		set-base-anchor 'aboveBraceR' (markMiddle - (RightSB - SB) / 2 - DotRadius) aboveMarkMid

	derive-glyphs 'commaBR' null 'commaBelow' : function [src gr] : glyph-proc
		set-width 0

		include : refer-glyph src
		include : ApparentTranslate ((RightSB + DotRadius) - Middle) 0
		currentGlyph.clearAnchors

		set-mark-anchor 'bottomRight' (markMiddle + (RightSB - SB) / 2) 0 (markMiddle + (RightSB - SB) / 2 + DotRadius) belowMarkBot
		set-base-anchor 'belowBraceL' (markMiddle + (RightSB - SB) / 2 + DotRadius) belowMarkMid
		set-base-anchor 'belowBraceR' (markMiddle + (RightSB - SB) / 2 + DotRadius) belowMarkMid

	create-glyph 'cyrl/kavykaTR' 0x1DF6 : glyph-proc
		set-width 0
		include : CyrKavykaShape
			xMiddle -- 0
			width   -- (2 * (markExtend * 1.5 - [HSwToV markHalfStroke]))
			top     -- aboveMarkTop
			bottom  -- aboveMarkBot
			hs      -- markHalfStroke
		set-mark-anchor 'topRight' 0 XH 0 aboveMarkTop
		set-base-anchor 'aboveBraceL' ((-0.75) * markExtend) aboveMarkMid
		set-base-anchor 'aboveBraceR' ((+0.75) * markExtend) aboveMarkMid

	create-glyph 'cyrl/kavykaTL' 0x1DF7 : glyph-proc
		set-width 0
		include : CyrKavykaShape
			xMiddle -- 0
			width   -- (2 * (markExtend * 1.5 - [HSwToV markHalfStroke]))
			top     -- aboveMarkTop
			bottom  -- aboveMarkBot
			hs      -- markHalfStroke
		set-mark-anchor 'topLeft' 0 XH 0 aboveMarkTop
		set-base-anchor 'aboveBraceL' ((-0.75) * markExtend) aboveMarkMid
		set-base-anchor 'aboveBraceR' ((+0.75) * markExtend) aboveMarkMid

	create-glyph 'rightHalfRingTR' : glyph-proc
		set-width 0

		include : refer-glyph "leftHalfRingBelow"
		include : FlipAround markMiddle (XH / 2)
		currentGlyph.clearAnchors

		set-mark-anchor 'topRight' markMiddle XH markMiddle aboveMarkStack
		set-base-anchor 'aboveBraceL' markMiddle aboveMarkMid
		set-base-anchor 'aboveBraceR' markMiddle aboveMarkMid

	define ogonekTrConfig : object
		'ogonekTR'   { (7/16) (1/8) 1 0   }
		'ogonekTR_Y' { (3/16) 1     6 0.5 }

	foreach { glyphName { pExtL pExtR cwMidStrokeWidth paren } } [Object.entries ogonekTrConfig] : do
		local depth : 0 - Descender - markStroke

		create-glyph glyphName : glyph-proc
			set-width 0

			local fine : AdviceStroke 8
			local extL : pExtL * depth + 0.125 * markStress
			local extR : Math.max (pExtR * markExtend) (1.5 * TanSlope * markStroke)

			local turnSlope : 0.5 * ((markStroke - fine) / markStroke - (ArchDepthB - ArchDepth) / ArchDepth)
			local swMid : Math.min markStroke [AdviceStroke cwMidStrokeWidth]

			include : difference
				dispiro
					g4 markMiddle 0 [widths.rhs.heading fine Leftward]
					alsoThru 0.5 (0.375 - 0.2 * markStroke / depth) [widths.rhs : mix fine swMid 0.25]
					g4.down.mid (markMiddle - extL) ((-0.75) * depth) [widths.rhs.heading swMid {.x HVContrast .y turnSlope}]
					arcvh
					g4 (markMiddle + [mix (-extL) extR (11/16)]) ((-depth) + O) [widths.rhs.heading markStroke Rightward]
					g4 (markMiddle + extR) ((-depth) + 0.5 * O) [heading Rightward]
				intersection
					MaskAbove 0
					MaskRight markMiddle

			set-mark-anchor 'trailing' markMiddle 0 (markMiddle + extR) ((-depth) - 0.5 * O - markStroke)
			set-base-anchor 'belowBraceL' (markMiddle - extL - paren * markExtend - [HSwToV : 0.25 * swMid]) ((-0.75) * depth)
			set-base-anchor 'belowBraceR' (markMiddle - 0.75 * extL + paren * markExtend) ((-0.75) * depth)

		create-glyph "\(glyphName)/spacer" : glyph-proc
			set-width 0
			set-mark-anchor 'below' 0 0 0 ((-depth) - 0.5 * O - markStroke)
